# Copy to .env only on the server. Never commit the real file.
# Use the EXISTING password for an existing PostgreSQL volume; changing this does not rotate it.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
LLM_PROVIDER=rules
LLM_MODEL=qwen3:4b
# Resolve the existing server image RepoDigest; do not paste this placeholder literally.
OLLAMA_IMAGE=ollama/ollama@sha256:REPLACE_WITH_TESTED_IMAGE_DIGEST
