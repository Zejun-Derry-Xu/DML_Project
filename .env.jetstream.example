# PRIVATE OPERATOR CONFIG: copy to .env, chmod 600. Never put real secrets in Git.
# For an existing volume use its CURRENT password; changing this does not rotate it.
POSTGRES_PASSWORD=
DEMO_SESSION_SECRET=
DEMO_COOKIE_SECURE=false
# Default private UI. Set to 0.0.0.0 only for an approved public synthetic demo.
# This exposes only the Nginx entry point on port 5173; API/DB/model stay private.
# Plain HTTP is demonstration-only: never enter real personal data or credentials.
FRONTEND_BIND_ADDRESS=127.0.0.1
# Start guided. Enable llm only after the matching reviewed CPU qualification.
EXTRACTION_MODE=guided
# Show all applicable conditions; explicit button attestation works without a model.
# conversational / individual retain the historical collection baselines.
COLLECTION_STYLE=checklist
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0
# For model-profile use, set the tested official Ollama runtime by digest.
# OLLAMA_IMAGE=ollama/ollama@sha256:<64-hex-digest-from-your-tested-runtime>
