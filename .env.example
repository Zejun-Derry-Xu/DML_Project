ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://returnflow:returnflow@localhost:5432/returnflow
CORS_ORIGINS=["http://localhost:5173"]
QUESTION_TTL_MINUTES=10
QUESTION_CLEANUP_INTERVAL_SECONDS=60

# Use "rules" for deterministic local development and CI.
LLM_PROVIDER=rules
LLM_MODEL=qwen3:4b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
# Policy retrieval spike. Lexical/extractive works without external services.
POLICY_RETRIEVER=lexical
POLICY_GENERATOR=extractive
# For the optional semantic path, start Qdrant and pull an Ollama embedding model.
POLICY_QDRANT_URL=http://localhost:6333
POLICY_QDRANT_COLLECTION=returnflow_policy_mvp_1
POLICY_QDRANT_API_KEY=
POLICY_OLLAMA_URL=http://localhost:11434
POLICY_EMBEDDING_MODEL=embeddinggemma
POLICY_MIN_VECTOR_SCORE=0.25
LOG_LEVEL=INFO
