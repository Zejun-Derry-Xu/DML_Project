ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://returnflow:returnflow@localhost:5432/returnflow
CORS_ORIGINS=["http://localhost:5173"]
QUESTION_TTL_MINUTES=10
QUESTION_CLEANUP_INTERVAL_SECONDS=60

# The new flow is LLM-first; guided mode never uses semantic keyword rules.
WORKFLOW_MODE=apparel
EXTRACTION_MODE=llm
DEMO_ENABLED=true
# Generate with: openssl rand -hex 32. Never commit the resulting secret.
DEMO_SESSION_SECRET=
DEMO_COOKIE_SECURE=false
LLM_PROVIDER=ollama
# Local Ollama tag. Compose and config.py use the same qwen3:4b default.
# Hosted Model Studio uses qwen3.7-flash (alias of qwen3.7-flash-2026-07-15).
LLM_MODEL=qwen3:4b
LLM_TEMPERATURE=0
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
# Hosted Qwen Flash. The key belongs only in this private .env (or the process
# environment). Do not put it in the frontend, git, or logs.
#   LLM_PROVIDER=dashscope
#   LLM_MODEL=qwen3.7-flash
# Singapore, any workspace key in that region:
#   LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Singapore workspace domain (replace the id; preferred for production):
#   LLM_BASE_URL=https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# US (Virginia), key must be created in that region:
#   LLM_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
#   LLM_BASE_URL=https://YOUR_WORKSPACE_ID.us-east-1.maas.aliyuncs.com/compatible-mode/v1
# China (Beijing):
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# auto: json_schema, then json_object if the region returns HTTP 400.
# json_schema and json_object force one mode. Local schema checks always run.
DASHSCOPE_API_KEY=
DASHSCOPE_RESPONSE_FORMAT=auto
# Policy retrieval spike. Lexical/extractive works without external services.
POLICY_RETRIEVER=lexical
POLICY_GENERATOR=extractive
# For the optional semantic path, start Qdrant and pull an Ollama embedding model.
POLICY_QDRANT_URL=http://localhost:6333
POLICY_QDRANT_COLLECTION=returnflow_policy_mvp_1
POLICY_QDRANT_API_KEY=
POLICY_OLLAMA_URL=http://localhost:11434
POLICY_EMBEDDING_MODEL=embeddinggemma
POLICY_MIN_VECTOR_SCORE=0.25
LOG_LEVEL=INFO
